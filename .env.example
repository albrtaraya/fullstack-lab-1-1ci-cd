# Variables de entorno del proyecto.
# Copia este archivo como .env y ajusta los valores si hace falta:
#     cp .env.example .env
#
# Para levantar todo con Docker Compose no necesitas tocar nada: los valores
# de abajo son los mismos que usa docker-compose.yml.

# Cadena de conexion a PostgreSQL.
# Dentro de Docker Compose el host es `postgres` (el nombre del servicio).
# Si corres el backend fuera de Docker contra una base local, usa `localhost`.
DATABASE_URL=postgresql://appuser:apppass@postgres:5432/appdb

# Puerto en el que escucha la API de tareas.
PORT=4000

# URL de la API que consume el navegador. Se inyecta al construir el frontend.
PUBLIC_API_URL=http://localhost:4000
