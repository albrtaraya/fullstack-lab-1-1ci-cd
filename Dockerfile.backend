# Imagen del backend: la API de tareas (Express).
#
# El proyecto no separa las carpetas frontend/ y backend/ como en el ejemplo de
# la guía: es una sola aplicación con la API en src/server/. Por eso hay dos
# Dockerfile en la raíz (uno por servicio) en lugar de uno dentro de cada carpeta.

FROM node:22-alpine

WORKDIR /app

# Se copia primero el manifiesto y se instalan las dependencias: así Docker
# reutiliza esta capa —la más cara— mientras no cambien las dependencias,
# aunque el código fuente cambie todos los días.
COPY package*.json ./
RUN npm ci --omit=dev

COPY src ./src

EXPOSE 4000

# Sonda de salud: la usa Compose para saber si el backend está realmente listo.
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
	CMD node -e "fetch('http://localhost:4000/salud').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "src/server/index.js"]
